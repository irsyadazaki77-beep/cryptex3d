{
    "version":  "v1",
    "hooks":  [
                  {
                      "description":  "Verify .kiro is not in .gitignore and the root MIT LICENSE remains intact at session start.",
                      "name":  "Repo Hygiene Check",
                      "action":  {
                                     "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File .kiro/hooks/repo-hygiene.ps1",
                                     "timeout":  15,
                                     "type":  "command"
                                 },
                      "trigger":  "SessionStart"
                  }
              ]
}
