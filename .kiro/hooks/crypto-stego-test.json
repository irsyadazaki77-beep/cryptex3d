{
    "version":  "v1",
    "hooks":  [
                  {
                      "matcher":  "src/core/(crypto|stego)/.*",
                      "description":  "Run vitest in single-pass mode whenever a file in src/core/crypto/ or src/core/stego/ is saved, to catch regressions immediately without blocking the agent.",
                      "name":  "Crypto/Stego Test Runner",
                      "action":  {
                                     "command":  "npx vitest --run",
                                     "timeout":  300,
                                     "type":  "command"
                                 },
                      "trigger":  "PostFileSave"
                  }
              ]
}
